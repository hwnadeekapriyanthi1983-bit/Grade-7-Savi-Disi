<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grade 7 Learning Hub - English Medium Sri Lanka</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            800: '#3730a3',
                            900: '#312e81',
                        }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            scroll-behavior: smooth;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        .dark ::-webkit-scrollbar-track {
            background: #1f2937;
        }
        ::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
        .glass-card {
            backdrop-filter: blur(8px);
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen transition-colors duration-300">

    <!-- TOP ANNOUNCEMENT BAR -->
    <div class="bg-gradient-to-r from-brand-600 via-indigo-600 to-purple-600 text-white text-xs md:text-sm py-2 px-4 text-center font-medium shadow-md">
        <span><i class="fa-solid fa-graduation-cap mr-2"></i> Grade 7 Sri Lankan National Curriculum (English Medium) Resource Hub</span>
    </div>

    <!-- MAIN NAVBAR -->
    <nav class="sticky top-0 z-40 bg-white/90 dark:bg-slate-900/90 border-b border-slate-200 dark:border-slate-800 backdrop-blur-md transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <!-- Logo -->
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-brand-500/30">
                        <i class="fa-solid fa-book-open text-xl"></i>
                    </div>
                    <div>
                        <span class="font-bold text-lg leading-tight block text-slate-900 dark:text-white">Grade 7 Hub</span>
                        <span class="text-xs text-brand-600 dark:text-brand-400 font-semibold tracking-wider uppercase">English Medium</span>
                    </div>
                </div>

                <!-- Desktop Menu -->
        <div class="hidden md:flex items-center space-x-6 text-sm font-medium">
            <a href="#home" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Home</a>
            <a href="#subjects" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Subjects</a>
            <a href="#notes-section" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Short Notes</a>
            <a href="#tracker" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Study Tracker</a>
            <a href="#quiz" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Practice Quiz</a>
            <a href="#downloads" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Downloads</a>
        </div>

                <!-- Actions -->
                <div class="flex items-center gap-3">
                    <!-- Dark Mode Toggle Button -->
                    <button id="themeToggle" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">
                        <i id="themeIcon" class="fa-solid fa-moon text-lg"></i>
                    </button>
                    <!-- Mobile menu toggle -->
                    <button id="mobileMenuBtn" class="md:hidden p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Container -->
        <div id="mobileMenu" class="hidden md:hidden border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 pt-2 pb-4 space-y-2 text-sm font-medium">
            <a href="#home" class="block py-2 text-slate-700 dark:text-slate-300 hover:text-brand-600">Home</a>
            <a href="#subjects" class="block py-2 text-slate-700 dark:text-slate-300 hover:text-brand-600">Subjects</a>
            <a href="#tracker" class="block py-2 text-slate-700 dark:text-slate-300 hover:text-brand-600">Study Tracker</a>
            <a href="#quiz" class="block py-2 text-slate-700 dark:text-slate-300 hover:text-brand-600">Practice Quiz</a>
            <a href="#downloads" class="block py-2 text-slate-700 dark:text-slate-300 hover:text-brand-600">Downloads</a>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <section id="home" class="relative overflow-hidden pt-12 pb-16 md:py-20 bg-gradient-to-b from-brand-50/50 via-white to-slate-50 dark:from-slate-900 dark:via-slate-900 dark:to-slate-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-brand-100 dark:bg-brand-900/50 text-brand-700 dark:text-brand-300 mb-4 border border-brand-200 dark:border-brand-800">
                <i class="fa-solid fa-sparkles mr-1.5"></i> Comprehensive Study Resource Portal
            </span>
            <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white mb-6">
                Master Grade 7 Curriculum <br>
                <span class="bg-gradient-to-r from-brand-600 via-indigo-600 to-purple-600 bg-clip-text text-transparent">With Confidence & Ease</span>
            </h1>
            <p class="max-w-2xl mx-auto text-slate-600 dark:text-slate-300 text-base md:text-lg mb-8 leading-relaxed">
                Access term-wise syllabus breakdowns, summarized lesson notes, model exam papers, interactive quizzes, and track your study progress—all in one place!
            </p>

            <!-- Search Bar -->
            <div class="max-w-xl mx-auto relative mb-10">
                <div class="relative flex items-center">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 text-slate-400 text-lg"></i>
                    <input type="text" id="searchInput" placeholder="Search subjects, topics (e.g., Algebra, Plant Diversity, Anuradhapura)..." 
                        class="w-full pl-12 pr-4 py-4 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-xl shadow-brand-500/5 focus:outline-none focus:ring-2 focus:ring-brand-500 transition-all text-sm md:text-base">
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-4 border-t border-slate-200 dark:border-slate-800">
                <div class="p-3">
                    <p class="text-2xl md:text-3xl font-extrabold text-brand-600 dark:text-brand-400">8 Subject</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Complete Coverage</p>
                </div>
                <div class="p-3">
                    <p class="text-2xl md:text-3xl font-extrabold text-purple-600 dark:text-purple-400">3 Terms</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Syllabus Divided</p>
                </div>
                <div class="p-3">
                    <p class="text-2xl md:text-3xl font-extrabold text-indigo-600 dark:text-indigo-400">Model Papers</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Downloadable PDFs</p>
                </div>
                <div class="p-3">
                    <p class="text-2xl md:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400">Live Quizzes</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Instant Evaluation</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SUBJECTS SECTION -->
    <section id="subjects" class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
            <div>
                <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white">Grade 7 Subject Modules</h2>
                <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">Click on any subject card or "Read Short Notes" to open detailed study notes instantly.</p>
            </div>

            <!-- Filter Buttons -->
            <div class="flex flex-wrap gap-2" id="filterContainer">
                <button data-filter="all" class="filter-btn active-filter px-4 py-2 rounded-xl text-xs md:text-sm font-semibold bg-brand-600 text-white shadow-md transition-all">All Subjects</button>
                <button data-filter="stem" class="filter-btn px-4 py-2 rounded-xl text-xs md:text-sm font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all">STEM</button>
                <button data-filter="humanities" class="filter-btn px-4 py-2 rounded-xl text-xs md:text-sm font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all">Humanities</button>
                <button data-filter="languages" class="filter-btn px-4 py-2 rounded-xl text-xs md:text-sm font-semibold bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all">Languages & Other</button>
            </div>
        </div>

        <!-- Subjects Grid -->
        <div id="subjectsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Cards generated dynamically via JavaScript -->
        </div>
    </section>

    <!-- INTERACTIVE SHORT NOTES READER SECTION -->
    <section id="notes-section" class="py-12 bg-white dark:bg-slate-900 border-t border-b border-slate-200 dark:border-slate-800 transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                <div>
                    <span class="text-xs font-bold text-brand-600 dark:text-brand-400 tracking-wider uppercase">Interactive Reader</span>
                    <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
                        <i class="fa-solid fa-book-bookmark text-brand-600"></i> Detailed Grade 7 Short Notes
                    </h2>
                </div>

                <!-- Subject Selector Tabs -->
                <div class="flex overflow-x-auto pb-2 md:pb-0 gap-2 max-w-full no-scrollbar" id="notesTabs">
                    <!-- Dynamic tabs populated via JS -->
                </div>
            </div>

            <!-- Main Notes Reader Container -->
            <div id="notesReader" class="bg-slate-50 dark:bg-slate-800/60 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700/80 shadow-lg min-h-[450px]">
                <!-- Dynamic Content Populated by JS -->
            </div>
        </div>
    </section>

    <!-- STUDY PROGRESS TRACKER -->
    <section id="tracker" class="py-12 bg-slate-100 dark:bg-slate-800/50 my-8 transition-colors">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-8">
                <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white">Interactive Study Tracker</h2>
                <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">Keep track of core Grade 7 topics you have completed.</p>
                
                <!-- Progress Bar -->
                <div class="mt-6 bg-white dark:bg-slate-800 p-4 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700">
                    <div class="flex justify-between text-xs font-semibold mb-2">
                        <span>Overall Completion</span>
                        <span id="progressPercentage">0%</span>
                    </div>
                    <div class="w-full bg-slate-200 dark:bg-slate-700 rounded-full h-3.5 overflow-hidden">
                        <div id="progressBar" class="bg-gradient-to-r from-brand-500 to-emerald-500 h-3.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- Checklists Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4" id="trackerGrid">
                <!-- Populated via JavaScript -->
            </div>
        </div>
    </section>

    <!-- INTERACTIVE QUIZ SECTION -->
    <section id="quiz" class="py-12 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 shadow-xl border border-slate-200 dark:border-slate-700 relative overflow-hidden">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-12 h-12 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center text-2xl font-bold">
                    <i class="fa-solid fa-award"></i>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Grade 7 Speed Quiz Challenge</h2>
                    <p class="text-slate-500 dark:text-slate-400 text-xs md:text-sm">Test your knowledge across core subjects!</p>
                </div>
            </div>

            <div id="quizContainer">
                <div class="flex justify-between items-center mb-4 text-xs font-semibold text-slate-400">
                    <span id="quizQuestionCount">Question 1 of 5</span>
                    <span id="quizSubjectTag" class="px-2.5 py-1 bg-brand-100 dark:bg-brand-900/40 text-brand-600 dark:text-brand-300 rounded-lg">Mathematics</span>
                </div>
                <h3 id="quizQuestion" class="text-lg md:text-xl font-bold text-slate-800 dark:text-white mb-6">Loading Question...</h3>

                <div id="quizOptions" class="grid grid-cols-1 gap-3 mb-6">
                    <!-- Options populated via JS -->
                </div>

                <div class="flex justify-between items-center pt-4 border-t border-slate-200 dark:border-slate-700">
                    <div id="quizFeedback" class="text-sm font-semibold"></div>
                    <button id="nextQuestionBtn" class="hidden px-6 py-2.5 bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm rounded-xl transition-all shadow-md">
                        Next Question <i class="fa-solid fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>

            <!-- Quiz Result View -->
            <div id="quizResult" class="hidden text-center py-8">
                <div class="w-20 h-20 mx-auto rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-500 flex items-center justify-center text-4xl mb-4">
                    <i class="fa-solid fa-trophy"></i>
                </div>
                <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Quiz Completed!</h3>
                <p class="text-slate-600 dark:text-slate-300 text-base mb-6">You scored <span id="finalScore" class="font-bold text-brand-600 dark:text-brand-400 text-2xl">0/5</span></p>
                <button onclick="resetQuiz()" class="px-6 py-3 bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm rounded-xl shadow-lg transition-all">
                    <i class="fa-solid fa-rotate-right mr-2"></i> Retake Quiz
                </button>
            </div>
        </div>
    </section>

    <!-- DOWNLOADS SECTION -->
    <section id="downloads" class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-10">
            <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white">Download Paper Hub</h2>
            <p class="text-slate-600 dark:text-slate-400 text-sm mt-1">Get term test papers, model evaluation sheets, and short revision notes in PDF format.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-all">
                <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-file-pdf"></i>
                </div>
                <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-1">Term 1 Model Papers</h3>
                <p class="text-slate-500 dark:text-slate-400 text-xs mb-4">Complete set covering Mathematics, Science, and English.</p>
                <button onclick="downloadMock('Term-1-Model-Papers.pdf')" class="w-full py-2.5 border border-brand-600 text-brand-600 dark:text-brand-400 dark:border-brand-500 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-500 dark:hover:text-white rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-download"></i> Download Package (PDF)
                </button>
            </div>

            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-all">
                <div class="w-12 h-12 rounded-xl bg-purple-500/10 text-purple-500 flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-file-pdf"></i>
                </div>
                <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-1">Term 2 Evaluation Sets</h3>
                <p class="text-slate-500 dark:text-slate-400 text-xs mb-4">Includes History, Geography, and ICT revision papers.</p>
                <button onclick="downloadMock('Term-2-Evaluation-Papers.pdf')" class="w-full py-2.5 border border-brand-600 text-brand-600 dark:text-brand-400 dark:border-brand-500 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-500 dark:hover:text-white rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-download"></i> Download Package (PDF)
                </button>
            </div>

            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-all">
                <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-file-pdf"></i>
                </div>
                <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-1">Formula & Note Sheets</h3>
                <p class="text-slate-500 dark:text-slate-400 text-xs mb-4">Quick review summary sheets for rapid exam preparation.</p>
                <button onclick="downloadMock('Grade7-Short-Notes-Summary.pdf')" class="w-full py-2.5 border border-brand-600 text-brand-600 dark:text-brand-400 dark:border-brand-500 hover:bg-brand-600 hover:text-white dark:hover:bg-brand-500 dark:hover:text-white rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-download"></i> Download Package (PDF)
                </button>
            </div>
        </div>
    </section>

    <!-- LESSON DETAIL MODAL -->
    <div id="lessonModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-800 rounded-3xl max-w-2xl w-full max-h-[85vh] overflow-hidden flex flex-col shadow-2xl border border-slate-200 dark:border-slate-700">
            <!-- Modal Header -->
            <div class="p-6 border-b border-slate-200 dark:border-slate-700 flex justify-between items-center bg-slate-50 dark:bg-slate-800/80">
                <div class="flex items-center gap-3">
                    <div id="modalIcon" class="w-10 h-10 rounded-xl bg-brand-500 text-white flex items-center justify-center text-lg font-bold">
                        <i class="fa-solid fa-book"></i>
                    </div>
                    <div>
                        <h3 id="modalTitle" class="text-xl font-bold text-slate-900 dark:text-white">Subject Title</h3>
                        <span id="modalCategory" class="text-xs font-medium text-brand-600 dark:text-brand-400">Category</span>
                    </div>
                </div>
                <button onclick="closeModal()" class="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 flex items-center justify-center hover:bg-slate-300 dark:hover:bg-slate-600 transition-all">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Modal Content -->
            <div class="p-6 overflow-y-auto space-y-6 text-sm text-slate-600 dark:text-slate-300" id="modalBody">
                <!-- Dynamic Content injected here -->
            </div>

            <!-- Modal Footer -->
            <div class="p-4 border-t border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 flex justify-end gap-3">
                <button onclick="closeModal()" class="px-5 py-2.5 rounded-xl text-xs font-bold text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all">Close</button>
                <button id="modalDownloadBtn" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-brand-600 hover:bg-brand-700 text-white shadow-md transition-all flex items-center gap-2">
                    <i class="fa-solid fa-file-arrow-down"></i> Download Notes PDF
                </button>
            </div>
        </div>
    </div>

    <!-- NOTIFICATION TOAST -->
    <div id="toast" class="fixed bottom-5 right-5 bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-3 text-sm font-medium transform translate-y-20 opacity-0 transition-all duration-300 z-50">
        <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400 dark:text-emerald-600"></i>
        <span id="toastMsg">Notification message</span>
    </div>

    <!-- FOOTER -->
    <footer class="bg-slate-900 text-slate-400 py-12 border-t border-slate-800 text-xs md:text-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
            <div class="col-span-1 md:col-span-2">
                <div class="flex items-center gap-2 text-white font-bold text-lg mb-3">
                    <i class="fa-solid fa-graduation-cap text-brand-500"></i> Grade 7 English Medium Hub
                </div>
                <p class="text-slate-400 max-w-sm leading-relaxed">
                    Dedicated learning platform designed to help Grade 7 Sri Lankan students excel in their term evaluations with curriculum-aligned content.
                </p>
            </div>
            <div>
                <h4 class="text-white font-semibold mb-3">Quick Links</h4>
                <ul class="space-y-2">
                    <li><a href="#subjects" class="hover:text-white transition-colors">Subject Summaries</a></li>
                    <li><a href="#tracker" class="hover:text-white transition-colors">Syllabus Tracker</a></li>
                    <li><a href="#quiz" class="hover:text-white transition-colors">Model Speed Quiz</a></li>
                    <li><a href="#downloads" class="hover:text-white transition-colors">Resource PDF Downloads</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-semibold mb-3">Core Subjects</h4>
                <p class="leading-relaxed">Mathematics, Science, English, History, ICT, Geography, Health, Civics Education.</p>
            </div>
        </div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 border-t border-slate-800 text-center text-slate-500">
            <p>&copy; 2026 Grade 7 Learning Hub (Sri Lanka English Medium). Free Educational Resource.</p>
        </div>
    </footer>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Subject Data Source with Comprehensive Short Notes
        const subjectsData = [
            {
                id: 'math',
                name: 'Mathematics',
                category: 'stem',
                icon: 'fa-calculator',
                color: 'from-blue-500 to-indigo-600',
                terms: {
                    term1: ['Sets & Venn Diagrams', 'Perimeter of Plane Figures', 'Algebraic Expressions', 'Fractions & Decimals'],
                    term2: ['Angles & Lines', 'Directed Numbers', 'Ratios & Percentages', 'Area of Plane Figures'],
                    term3: ['Equations & Inequalities', 'Data Handling & Graphs', 'Volume & Capacity', 'Probability Basics']
                },
                summary: 'Grade 7 Mathematics expands fundamental numerical concepts into algebraic reasoning, spatial geometry, and data interpretation according to the national syllabus.',
                shortNotes: [
                    {
                        topic: '1. Sets & Venn Diagrams',
                        type: 'concept',
                        content: `
                            <p class="mb-2 font-medium">A <strong>Set</strong> is a well-defined collection of distinct objects (elements).</p>
                            <ul class="list-disc list-inside space-y-1 text-slate-600 dark:text-slate-300">
                                <li><strong>Finite Set:</strong> Elements can be counted (e.g., A = {2, 4, 6, 8}).</li>
                                <li><strong>Infinite Set:</strong> Elements cannot be completely listed (e.g., set of all odd numbers).</li>
                                <li><strong>Venn Diagram:</strong> Visual representation of sets using circles inside a universal set rectangle.</li>
                            </ul>
                        `
                    },
                    {
                        topic: '2. Perimeter & Area Formulas',
                        type: 'formula',
                        content: `
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <div class="bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700">
                                    <span class="font-bold text-brand-600 block text-xs">Perimeter of Rectangle:</span>
                                    <code>P = 2 × (Length + Width)</code>
                                </div>
                                <div class="bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700">
                                    <span class="font-bold text-brand-600 block text-xs">Area of Triangle:</span>
                                    <code>Area = ½ × Base × Height</code>
                                </div>
                                <div class="bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700">
                                    <span class="font-bold text-brand-600 block text-xs">Perimeter of Square:</span>
                                    <code>P = 4 × Side Length</code>
                                </div>
                                <div class="bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700">
                                    <span class="font-bold text-brand-600 block text-xs">Area of Parallelogram:</span>
                                    <code>Area = Base × Perpendicular Height</code>
                                </div>
                            </div>
                        `
                    },
                    {
                        topic: '3. Algebraic Expressions',
                        type: 'note',
                        content: `
                            <ul class="list-disc list-inside space-y-2">
                                <li><strong>Variable:</strong> A letter representing an unknown quantity (e.g., <em>x, y, a</em>).</li>
                                <li><strong>Like Terms:</strong> Terms with identical algebraic factors (e.g., 3x and 7x). Only like terms can be added or subtracted!</li>
                                <li><strong>Simplification Example:</strong> <code>4x + 5y - 2x + 3y = (4x - 2x) + (5y + 3y) = 2x + 8y</code>.</li>
                            </ul>
                        `
                    }
                ]
            },
            {
                id: 'science',
                name: 'Science',
                category: 'stem',
                icon: 'fa-flask',
                color: 'from-emerald-500 to-teal-600',
                terms: {
                    term1: ['Plant Diversity & Characteristics', 'Properties of Matter & States', 'Energy Forms & Transformation'],
                    term2: ['Human Organ Systems (Digestive/Respiratory)', 'Elements & Compounds', 'Heat & Temperature'],
                    term3: ['Electric Circuits & Conductors', 'Sound & Human Ear', 'Soil Structure & Ecosystems']
                },
                summary: 'Science engages students with experimental inquiry into living organisms, matter properties, physical energy forms, and environmental balance.',
                shortNotes: [
                    {
                        topic: '1. Plant Diversity & Adaptation',
                        type: 'concept',
                        content: `
                            <p class="mb-2">Plants adapt to their habitats in unique structural ways:</p>
                            <ul class="list-disc list-inside space-y-1 text-slate-600 dark:text-slate-300">
                                <li><strong>Hydrophytes (Water plants):</strong> Air spaces in stems (e.g., Water Lily, Lotus) for buoyancy.</li>
                                <li><strong>Xerophytes (Dry area plants):</strong> Thick waxy leaves or spines (e.g., Cactus) to minimize transpiration loss.</li>
                                <li><strong>Monocotyledons:</strong> Parallel vein patterns, fibrous root system (e.g., Grass, Paddy).</li>
                                <li><strong>Dicotyledons:</strong> Reticulate net veins, taproot system (e.g., Mango, Bean).</li>
                            </ul>
                        `
                    },
                    {
                        topic: '2. States & Properties of Matter',
                        type: 'note',
                        content: `
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
                                <div class="bg-emerald-50 dark:bg-emerald-950/30 p-3 rounded-xl border border-emerald-200 dark:border-emerald-800">
                                    <h5 class="font-bold text-emerald-700 dark:text-emerald-400">Solids</h5>
                                    <p>Fixed shape, fixed volume. Particles tightly packed in regular order.</p>
                                </div>
                                <div class="bg-blue-50 dark:bg-blue-950/30 p-3 rounded-xl border border-blue-200 dark:border-blue-800">
                                    <h5 class="font-bold text-blue-700 dark:text-blue-400">Liquids</h5>
                                    <p>No fixed shape (takes container shape), fixed volume. Particles can slide.</p>
                                </div>
                                <div class="bg-purple-50 dark:bg-purple-950/30 p-3 rounded-xl border border-purple-200 dark:border-purple-800">
                                    <h5 class="font-bold text-purple-700 dark:text-purple-400">Gases</h5>
                                    <p>No fixed shape or volume. Particles far apart and move rapidly in all directions.</p>
                                </div>
                            </div>
                        `
                    },
                    {
                        topic: '3. Human Digestive System',
                        type: 'concept',
                        content: `
                            <p class="mb-2"><strong>Sequence of Digestion:</strong> Mouth → Esophagus → Stomach → Small Intestine → Large Intestine → Rectum → Anus.</p>
                            <ul class="list-disc list-inside space-y-1 text-slate-600 dark:text-slate-300">
                                <li><strong>Mouth:</strong> Salivary amylase begins breaking down starch into simple sugars.</li>
                                <li><strong>Stomach:</strong> Hydrochloric acid kills germs and pepsin digests proteins.</li>
                                <li><strong>Small Intestine:</strong> Complete digestion and absorption of nutrients into bloodstream via villi.</li>
                            </ul>
                        `
                    }
                ]
            },
            {
                id: 'english',
                name: 'English Language',
                category: 'languages',
                icon: 'fa-language',
                color: 'from-purple-500 to-pink-600',
                terms: {
                    term1: ['Nouns, Pronouns & Articles', 'Present & Past Continuous Tenses', 'Descriptive Composition'],
                    term2: ['Adjectives & Adverbs Usage', 'Formal & Informal Letter Writing', 'Reading Comprehension Strategies'],
                    term3: ['Active & Passive Voice Basics', 'Direct & Indirect Speech Introduction', 'Speech & Essay Writing']
                },
                summary: 'Designed to build fluency in grammar, expanding vocabulary, effective written composition, and analytical reading skills.',
                shortNotes: [
                    {
                        topic: '1. Tense Review & Formations',
                        type: 'formula',
                        content: `
                            <ul class="space-y-2 text-xs">
                                <li><strong class="text-purple-600 dark:text-purple-400">Simple Present:</strong> Subject + Verb (s/es) → <em>"She writes short notes every day."</em></li>
                                <li><strong class="text-purple-600 dark:text-purple-400">Present Continuous:</strong> Subject + am/is/are + Verb(-ing) → <em>"They are studying Grade 7 Science."</em></li>
                                <li><strong class="text-purple-600 dark:text-purple-400">Simple Past:</strong> Subject + Past Form of Verb → <em>"We completed our assignment yesterday."</em></li>
                            </ul>
                        `
                    },
                    {
                        topic: '2. Formal vs Informal Letter Structure',
                        type: 'note',
                        content: `
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                                <div class="bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700">
                                    <h5 class="font-bold text-slate-800 dark:text-white border-b pb-1 mb-2">Formal Letter (e.g., Principal/Officer)</h5>
                                    <p>Sender Address, Date, Receiver Title & Address, Subject Line, Salutation (Sir/Madam), Body Paragraphs, Sign-off (Yours faithfully).</p>
                                </div>
                                <div class="bg-white dark:bg-slate-800 p-3 rounded-xl border border-slate-200 dark:border-slate-700">
                                    <h5 class="font-bold text-slate-800 dark:text-white border-b pb-1 mb-2">Informal Letter (e.g., Friend/Family)</h5>
                                    <p>Sender Address, Date, Friendly Salutation (Dear Nimal), Casual Tone Body, Warm Closing (Your loving friend).</p>
                                </div>
                            </div>
                        `
                    }
                ]
            },
            {
                id: 'history',
                name: 'History',
                category: 'humanities',
                icon: 'fa-landmark',
                color: 'from-amber-500 to-orange-600',
                terms: {
                    term1: ['Sources of Sri Lankan History', 'Anuradhapura Kingdom Era', 'Early Hydraulic Civilization & Reservoirs'],
                    term2: ['Polonnaruwa Period Achievements', 'Social & Economic Life in Ancient Sri Lanka', 'Foreign Trade Relations'],
                    term3: ['Dambadeniya & Gampola Kingdoms', 'Art, Architecture & Sculptures of Sri Lanka']
                },
                summary: 'Explore Sri Lanka’s rich heritage, ancient hydraulic engineering marvels, royal dynasties, and historical sources.',
                shortNotes: [
                    {
                        topic: '1. Classification of Historical Sources',
                        type: 'concept',
                        content: `
                            <ul class="list-disc list-inside space-y-2 text-slate-600 dark:text-slate-300">
                                <li><strong>Literary Sources:</strong> 
                                    <em>Mahavamsa</em> (Great Chronicle), <em>Deepavamsa</em>, <em>Pujavaliya</em>, and foreign accounts by travelers like Fa-Hsien.
                                </li>
                                <li><strong>Archaeological Sources:</strong>
                                    Inscriptions (Rock & Pillar), Coins, Pottery, Ruins of Palaces, Temples, and Ancient Stupas.
                                </li>
                            </ul>
                        `
                    },
                    {
                        topic: '2. Ancient Hydraulic Engineering',
                        type: 'note',
                        content: `
                            <p class="mb-2">Sri Lanka is renowned for its sophisticated ancient water management systems:</p>
                            <ul class="list-disc list-inside space-y-1 text-slate-600 dark:text-slate-300">
                                <li><strong>Bisotuvawa (Valve Tower):</strong> Remarkable ancient invention to regulate water pressure release from large reservoirs.</li>
                                <li><strong>Famous Reservoir Constructors:</strong> King Dhatusena (Kala Wewa), King Mahasen (Minneriya Wewa), King Parakramabahu I (Parakrama Samudra).</li>
                            </ul>
                        `
                    }
                ]
            },
            {
                id: 'ict',
                name: 'Information Tech (ICT)',
                category: 'stem',
                icon: 'fa-laptop-code',
