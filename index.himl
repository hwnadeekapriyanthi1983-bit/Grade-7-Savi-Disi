                terms: {
                    term1: ['Introduction to Computer Hardware', 'Operating Systems & File Management', 'Keyboarding Skills'],
                    term2: ['Word Processing Basics (Formatting/Tables)', 'Presentation Software Tools', 'Computer Health & Safety'],
                    term3: ['Introduction to Algorithms & Flowcharts', 'The Internet, Browsers & Web Safety']
                },
                summary: 'Covers essential digital literacy skills, office software productivity tools, basic algorithmic thinking, and internet safety.',
                shortNotes: [
                    {
                        topic: '1. Computer System Components',
                        type: 'concept',
                        content: `
                            <ul class="list-disc list-inside space-y-1 text-slate-600 dark:text-slate-300">
                                <li><strong>Input Devices:</strong> Keyboard, Mouse, Scanner, Microphone.</li>
                                <li><strong>Output Devices:</strong> Monitor, Printer, Speaker, Projector.</li>
                                <li><strong>Processing Unit (CPU):</strong> ALU (Arithmetic Logic Unit) + CU (Control Unit).</li>
                                <li><strong>Storage:</strong> Primary (RAM/ROM) vs Secondary (Hard Disk, Pen Drive, SSD).</li>
                            </ul>
                        `
                    },
                    {
                        topic: '2. Flowchart Symbols & Meaning',
                        type: 'note',
                        content: `
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-center text-xs">
                                <div class="bg-white dark:bg-slate-800 p-2 rounded-xl border border-slate-200 dark:border-slate-700">
                                    <span class="font-bold text-cyan-600 block">Oval / Capsule</span>
                                    <span>Start / End</span>
                                </div>
                                <div class="bg-white dark:bg-slate-800 p-2 rounded-xl border border-slate-200 dark:border-slate-700">
                                    <span class="font-bold text-cyan-600 block">Parallelogram</span>
                                    <span>Input / Output</span>
                                </div>
                                <div class="bg-white dark:bg-slate-800 p-2 rounded-xl border border-slate-200 dark:border-slate-700">
                                    <span class="font-bold text-cyan-600 block">Rectangle</span>
                                    <span>Process</span>
                                </div>
                                <div class="bg-white dark:bg-slate-800 p-2 rounded-xl border border-slate-200 dark:border-slate-700">
                                    <span class="font-bold text-cyan-600 block">Diamond</span>
                                    <span>Decision</span>
                                </div>
                            </div>
                        `
                    }
                ]
            },
            {
                id: 'geography',
                name: 'Geography',
                category: 'humanities',
                icon: 'fa-earth-asia',
                color: 'from-teal-500 to-emerald-700',
                terms: {
                    term1: ['Earth’s Surface & Continents', 'Topographic & Map Reading Basics', 'Weather Elements & Instruments'],
                    term2: ['Climate Zones of Sri Lanka', 'Natural Hazards & Safety (Floods/Landslides)', 'Natural Resources & Land Use'],
                    term3: ['Population Distribution Patterns', 'Environmental Pollution & Conservation Solutions']
                },
                summary: 'Gain insight into Sri Lankan physical topography, climatic patterns, natural hazard preparedness, and map reading.',
                shortNotes: [
                    {
                        topic: '1. Map Symbols & Elements',
                        type: 'note',
                        content: `
                            <p class="mb-2">Key elements required on every accurate topographic map:</p>
                            <ul class="list-disc list-inside space-y-1 text-slate-600 dark:text-slate-300">
                                <li><strong>Title & Legend/Key:</strong> Explains standard conventional symbols used.</li>
                                <li><strong>Compass Rose (Direction):</strong> Indicates North arrow orientation.</li>
                                <li><strong>Scale:</strong> Represents ratio between distance on map and actual ground distance.</li>
                            </ul>
                        `
                    },
                    {
                        topic: '2. Weather Measuring Instruments',
                        type: 'concept',
                        content: `
                            <ul class="list-disc list-inside space-y-1 text-slate-600 dark:text-slate-300">
                                <li><strong>Temperature:</strong> Measured using a Thermometer (°C).</li>
                                <li><strong>Rainfall:</strong> Measured using a Rain Gauge (mm).</li>
                                <li><strong>Wind Speed:</strong> Measured using an Anemometer (km/h).</li>
                                <li><strong>Wind Direction:</strong> Measured using a Wind Vane.</li>
                            </ul>
                        `
                    }
                ]
            },
            {
                id: 'health',
                name: 'Health & Physical Ed.',
                category: 'languages',
                icon: 'fa-heart-pulse',
                color: 'from-rose-500 to-red-600',
                terms: {
                    term1: ['Physical Fitness & Body Posture', 'Balanced Nutrition & Healthy Diet', 'Personal Hygiene Practices'],
                    term2: ['Growth Changes in Adolescence', 'Safety Precautions in Sports', 'Preventing Diseases'],
                    term3: ['Mental Well-being & Stress Management', 'Team Sports & Athletics Techniques']
                },
                summary: 'Promotes physical wellness, adolescent health awareness, nutritional habits, and sportsmanship.',
                shortNotes: [
                    {
                        topic: '1. Balanced Diet & Food Pyramids',
                        type: 'note',
                        content: `
                            <p class="mb-2">A balanced diet provides all necessary nutrients in correct proportions:</p>
                            <ul class="list-disc list-inside space-y-1 text-slate-600 dark:text-slate-300">
                                <li><strong>Carbohydrates:</strong> Primary energy source (Rice, Bread, Yams).</li>
                                <li><strong>Proteins:</strong> Body building & tissue repair (Fish, Eggs, Pulses, Meat).</li>
                                <li><strong>Vitamins & Minerals:</strong> Disease prevention & immunity (Fresh Vegetables & Fruits).</li>
                            </ul>
                        `
                    }
                ]
            },
            {
                id: 'civics',
                name: 'Civic Education',
                category: 'humanities',
                icon: 'fa-scale-balanced',
                color: 'from-violet-500 to-purple-700',
                terms: {
                    term1: ['Good Citizenship & Duties', 'The School & Community Harmony', 'Cultural Diversity in Sri Lanka'],
                    term2: ['Rights & Responsibilities of Children', 'Local Government Institutions', 'Public Property Protection'],
                    term3: ['Rule of Law Basics', 'Democratic Values & Conflict Resolution']
                },
                summary: 'Fosters responsible citizenship, awareness of rights and duties, cultural tolerance, and community leadership.',
                shortNotes: [
                    {
                        topic: '1. Rights vs Responsibilities',
                        type: 'concept',
                        content: `
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                                <div class="bg-violet-50 dark:bg-violet-950/30 p-3 rounded-xl border border-violet-200 dark:border-violet-800">
                                    <h5 class="font-bold text-violet-700 dark:text-violet-400 mb-1">Child Rights</h5>
                                    <p>Right to education, health, protection from harm, and freedom of expression.</p>
                                </div>
                                <div class="bg-purple-50 dark:bg-purple-950/30 p-3 rounded-xl border border-purple-200 dark:border-purple-800">
                                    <h5 class="font-bold text-purple-700 dark:text-purple-400 mb-1">Citizen Duties</h5>
                                    <p>Protecting public property, respecting national flags/symbols, and obeying laws.</p>
                                </div>
                            </div>
                        `
                    }
                ]
            }
        ];

        // Quiz Question Pool
        const quizQuestions = [
            {
                subject: 'Mathematics',
                question: 'What is the perimeter of a regular hexagon with side length 5 cm?',
                options: ['20 cm', '25 cm', '30 cm', '35 cm'],
                answer: 2
            },
            {
                subject: 'Science',
                question: 'Which organ system is primarily responsible for transporting nutrients and oxygen throughout the body?',
                options: ['Digestive System', 'Circulatory System', 'Respiratory System', 'Nervous System'],
                answer: 1
            },
            {
                subject: 'History',
                question: 'Which ancient king constructed the famous Parakrama Samudra in Polonnaruwa?',
                options: ['King Dutugemunu', 'King Parakramabahu I', 'King Dhatusena', 'King Kasyapa'],
                answer: 1
            },
            {
                subject: 'ICT',
                question: 'Which of the following is considered system software?',
                options: ['Microsoft Word', 'Web Browser', 'Operating System', 'Media Player'],
                answer: 2
            },
            {
                subject: 'Geography',
                question: 'Which instrument is used to measure atmospheric pressure?',
                options: ['Thermometer', 'Barometer', 'Anemometer', 'Hygrometer'],
                answer: 1
            }
        ];

        // Core Topics for Progress Tracker
        const trackerTopics = [
            { id: 't1', subject: 'Math', title: 'Algebraic Expressions' },
            { id: 't2', subject: 'Math', title: 'Fractions & Decimals' },
            { id: 't3', subject: 'Science', title: 'Plant Diversity' },
            { id: 't4', subject: 'Science', title: 'Human Organ Systems' },
            { id: 't5', subject: 'English', title: 'Grammar & Tenses' },
            { id: 't6', subject: 'History', title: 'Anuradhapura Kingdom' },
            { id: 't7', subject: 'ICT', title: 'Word Processing & Tables' },
            { id: 't8', subject: 'Geography', title: 'Weather & Climate' }
        ];

        // Application State
        let activeSubjectId = 'math';
        let activeQuizIndex = 0;
        let quizScore = 0;
        let userProgress = JSON.parse(localStorage.getItem('g7_progress') || '{}');

        // INITIALIZE APP
        document.addEventListener('DOMContentLoaded', () => {
            renderSubjects(subjectsData);
            renderNotesTabs();
            renderNotesReader(activeSubjectId);
            renderTracker();
            loadQuizQuestion();
            setupTheme();

            // Search Filter Listener
            document.getElementById('searchInput').addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase();
                const filtered = subjectsData.filter(s => 
                    s.name.toLowerCase().includes(query) || 
                    s.summary.toLowerCase().includes(query) ||
                    Object.values(s.terms).flat().some(t => t.toLowerCase().includes(query))
                );
                renderSubjects(filtered);
            });

            // Filter Buttons Listener
            document.getElementById('filterContainer').addEventListener('click', (e) => {
                if (!e.target.classList.contains('filter-btn')) return;
                
                document.querySelectorAll('.filter-btn').forEach(btn => {
                    btn.classList.remove('bg-brand-600', 'text-white');
                    btn.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
                });

                e.target.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
                e.target.classList.add('bg-brand-600', 'text-white');

                const filter = e.target.dataset.filter;
                if (filter === 'all') {
                    renderSubjects(subjectsData);
                } else {
                    renderSubjects(subjectsData.filter(s => s.category === filter));
                }
            });

            // Mobile Menu Toggle
            document.getElementById('mobileMenuBtn').addEventListener('click', () => {
                const menu = document.getElementById('mobileMenu');
                menu.classList.toggle('hidden');
            });

            // Quiz Next Button
            document.getElementById('nextQuestionBtn').addEventListener('click', () => {
                activeQuizIndex++;
                if (activeQuizIndex < quizQuestions.length) {
                    loadQuizQuestion();
                } else {
                    showQuizResult();
                }
            });
        });

        // RENDER SUBJECT CARDS
        function renderSubjects(data) {
            const grid = document.getElementById('subjectsGrid');
            if (data.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-slate-400">
                        <i class="fa-solid fa-folder-open text-4xl mb-3"></i>
                        <p class="text-sm">No subject topics matched your search query.</p>
                    </div>`;
                return;
            }

            grid.innerHTML = data.map(sub => `
                <div onclick="selectSubjectNotes('${sub.id}')" class="cursor-pointer bg-white dark:bg-slate-800 rounded-3xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr ${sub.color} text-white flex items-center justify-center text-xl shadow-md group-hover:scale-110 transition-transform">
                                <i class="fa-solid ${sub.icon}"></i>
                            </div>
                            <span class="text-xs uppercase tracking-wider font-extrabold px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300">
                                ${sub.category}
                            </span>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">${sub.name}</h3>
                        <p class="text-slate-500 dark:text-slate-400 text-xs mb-4 line-clamp-2">${sub.summary}</p>
                        
                        <!-- Term Syllabus Preview -->
                        <div class="space-y-3 mb-6">
                            <div class="bg-slate-50 dark:bg-slate-900/50 p-3 rounded-xl border border-slate-100 dark:border-slate-700/50">
                                <span class="text-xs font-bold text-brand-600 dark:text-brand-400 block mb-1">Term 1 Key Topics:</span>
                                <p class="text-xs text-slate-600 dark:text-slate-400">${sub.terms.term1.slice(0, 2).join(', ')}...</p>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 pt-4 border-t border-slate-100 dark:border-slate-700" onclick="event.stopPropagation()">
                        <button onclick="selectSubjectNotes('${sub.id}')" class="flex-1 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-xs font-bold transition-colors shadow-sm flex items-center justify-center gap-2">
                            <i class="fa-solid fa-book-open"></i> Read Short Notes
                        </button>
                        <button onclick="openModal('${sub.id}')" class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition-colors" title="Full Syllabus Breakdown">
                            <i class="fa-solid fa-list-check"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // RENDER SHORT NOTES TABS & READER
        function renderNotesTabs() {
            const tabsContainer = document.getElementById('notesTabs');
            tabsContainer.innerHTML = subjectsData.map(sub => `
                <button onclick="selectSubjectNotes('${sub.id}')" class="notes-tab-btn flex-shrink-0 px-4 py-2 rounded-xl text-xs font-bold transition-all flex items-center gap-2 ${sub.id === activeSubjectId ? 'bg-brand-600 text-white shadow-md' : 'bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 hover:bg-slate-300 dark:hover:bg-slate-600'}">
                    <i class="fa-solid ${sub.icon}"></i> ${sub.name}
                </button>
            `).join('');
        }

        function selectSubjectNotes(subId) {
            activeSubjectId = subId;
            renderNotesTabs();
            renderNotesReader(subId);

            // Scroll smoothly to notes section if trigger came from card grid
            const notesElement = document.getElementById('notes-section');
            notesElement.scrollIntoView({ behavior: 'smooth' });
        }

        function renderNotesReader(subId) {
            const sub = subjectsData.find(s => s.id === subId);
            const container = document.getElementById('notesReader');

            if (!sub || !sub.shortNotes) {
                container.innerHTML = `<p class="text-center text-slate-400 py-12">No short notes available for this subject.</p>`;
                return;
            }

            container.innerHTML = `
                <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 mb-6 border-b border-slate-200 dark:border-slate-700 gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr ${sub.color} text-white flex items-center justify-center text-2xl shadow-md">
                            <i class="fa-solid ${sub.icon}"></i>
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-slate-900 dark:text-white">${sub.name} Revision Notes</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Essential Grade 7 syllabus definitions, rules, and formulas</p>
                        </div>
                    </div>
                    <button onclick="downloadMock('${sub.name}-Short-Notes.pdf')" class="self-start md:self-auto px-4 py-2 bg-slate-900 hover:bg-slate-800 dark:bg-white dark:text-slate-900 text-white rounded-xl text-xs font-bold transition-all shadow-sm flex items-center gap-2">
                        <i class="fa-solid fa-download"></i> Save Notes PDF
                    </button>
                </div>

                <div class="grid grid-cols-1 gap-6">
                    ${sub.shortNotes.map(note => `
                        <div class="bg-white dark:bg-slate-800 rounded-2xl p-5 border border-slate-200 dark:border-slate-700 shadow-sm">
                            <div class="flex items-center justify-between mb-3">
                                <h4 class="font-bold text-base text-slate-900 dark:text-white">${note.topic}</h4>
                                <span class="text-[10px] uppercase tracking-wider font-extrabold px-2 py-0.5 rounded-md ${note.type === 'formula' ? 'bg-amber-100 text-amber-700 dark:bg-amber-950/40 dark:text-amber-300' : note.type === 'concept' ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-950/40 dark:text-indigo-300' : 'bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300'}">
                                    ${note.type}
                                </span>
                            </div>
                            <div class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                                ${note.content}
                            </div>
                        </div>
                    `).join('')}
                </div>
            `;
        }

        // RENDER STUDY TRACKER
        function renderTracker() {
            const grid = document.getElementById('trackerGrid');
            const total = trackerTopics.length;
            let completed = 0;

            grid.innerHTML = trackerTopics.map(item => {
                const isChecked = !!userProgress[item.id];
                if (isChecked) completed++;

                return `
                    <div onclick="toggleTracker('${item.id}')" class="cursor-pointer p-4 rounded-2xl border ${isChecked ? 'bg-emerald-50 dark:bg-emerald-950/20 border-emerald-300 dark:border-emerald-800' : 'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700'} flex items-center gap-3 transition-all hover:border-brand-400">
                        <div class="w-6 h-6 rounded-lg ${isChecked ? 'bg-emerald-500 text-white' : 'border-2 border-slate-300 dark:border-slate-600'} flex items-center justify-center text-xs">
                            ${isChecked ? '<i class="fa-solid fa-check"></i>' : ''}
                        </div>
                        <div>
                            <span class="text-[10px] font-bold tracking-wider text-slate-400 uppercase">${item.subject}</span>
                            <h4 class="text-xs font-bold text-slate-800 dark:text-white">${item.title}</h4>
                        </div>
                    </div>
                `;
            }).join('');

            const percent = Math.round((completed / total) * 100);
            document.getElementById('progressBar').style.width = `${percent}%`;
            document.getElementById('progressPercentage').innerText = `${percent}% Completed`;
        }

        function toggleTracker(id) {
            userProgress[id] = !userProgress[id];
            localStorage.setItem('g7_progress', JSON.stringify(userProgress));
            renderTracker();
            showToast('Study progress updated!');
        }

        // MODAL HANDLERS
        function openModal(id) {
            const sub = subjectsData.find(s => s.id === id);
            if (!sub) return;

            document.getElementById('modalTitle').innerText = sub.name;
            document.getElementById('modalCategory').innerText = sub.category.toUpperCase() + ' MODULE';
            document.getElementById('modalDownloadBtn').onclick = () => downloadMock(`${sub.name}-Complete-Notes.pdf`);

            const modalBody = document.getElementById('modalBody');
            modalBody.innerHTML = `
                <div class="p-4 bg-brand-50 dark:bg-brand-950/30 rounded-2xl border border-brand-100 dark:border-brand-900/50">
                    <h4 class="font-bold text-brand-900 dark:text-brand-300 mb-1">Module Summary</h4>
                    <p class="text-xs text-brand-800 dark:text-brand-400">${sub.summary}</p>
                </div>

                <!-- Terms Breakdown -->
                <div class="space-y-4">
                    <div class="border border-slate-200 dark:border-slate-700 rounded-2xl p-4">
                        <h5 class="font-bold text-slate-900 dark:text-white text-sm mb-2 text-brand-600 dark:text-brand-400"><i class="fa-solid fa-calendar-check mr-2"></i> Term 1 Syllabus Topics</h5>
                        <ul class="list-disc list-inside space-y-1 text-xs text-slate-600 dark:text-slate-300">
                            ${sub.terms.term1.map(t => `<li>${t}</li>`).join('')}
                        </ul>
                    </div>

                    <div class="border border-slate-200 dark:border-slate-700 rounded-2xl p-4">
                        <h5 class="font-bold text-slate-900 dark:text-white text-sm mb-2 text-indigo-600 dark:text-indigo-400"><i class="fa-solid fa-calendar-check mr-2"></i> Term 2 Syllabus Topics</h5>
                        <ul class="list-disc list-inside space-y-1 text-xs text-slate-600 dark:text-slate-300">
                            ${sub.terms.term2.map(t => `<li>${t}</li>`).join('')}
                        </ul>
                    </div>

                    <div class="border border-slate-200 dark:border-slate-700 rounded-2xl p-4">
                        <h5 class="font-bold text-slate-900 dark:text-white text-sm mb-2 text-purple-600 dark:text-purple-400"><i class="fa-solid fa-calendar-check mr-2"></i> Term 3 Syllabus Topics</h5>
                        <ul class="list-disc list-inside space-y-1 text-xs text-slate-600 dark:text-slate-300">
                            ${sub.terms.term3.map(t => `<li>${t}</li>`).join('')}
                        </ul>
                    </div>
                </div>
            `;

            document.getElementById('lessonModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('lessonModal').classList.add('hidden');
        }

        // QUIZ SYSTEM LOGIC
        function loadQuizQuestion() {
            const q = quizQuestions[activeQuizIndex];
            document.getElementById('quizQuestionCount').innerText = `Question ${activeQuizIndex + 1} of ${quizQuestions.length}`;
            document.getElementById('quizSubjectTag').innerText = q.subject;
            document.getElementById('quizQuestion').innerText = q.question;
            document.getElementById('quizFeedback').innerText = '';
            document.getElementById('nextQuestionBtn').classList.add('hidden');

            const optionsContainer = document.getElementById('quizOptions');
            optionsContainer.innerHTML = q.options.map((opt, idx) => `
                <button onclick="checkAnswer(${idx})" class="quiz-opt-btn w-full p-4 text-left rounded-xl border border-slate-200 dark:border-slate-700 hover:border-brand-500 dark:hover:border-brand-500 bg-slate-50 dark:bg-slate-700/50 hover:bg-brand-50/50 dark:hover:bg-slate-700 text-sm font-medium transition-all flex items-center justify-between">
                    <span>${opt}</span>
                    <i class="fa-regular fa-circle text-slate-400"></i>
                </button>
            `).join('');
        }

        function checkAnswer(selectedIdx) {
            const q = quizQuestions[activeQuizIndex];
            const buttons = document.querySelectorAll('.quiz-opt-btn');
            
            // Disable buttons after answer
            buttons.forEach(btn => btn.disabled = true);

            if (selectedIdx === q.answer) {
                quizScore++;
                buttons[selectedIdx].classList.add('bg-emerald-100', 'dark:bg-emerald-950/40', 'border-emerald-500', 'text-emerald-700', 'dark:text-emerald-300');
                document.getElementById('quizFeedback').innerHTML = `<span class="text-emerald-600 dark:text-emerald-400"><i class="fa-solid fa-circle-check mr-1"></i> Correct Answer!</span>`;
            } else {
                buttons[selectedIdx].classList.add('bg-rose-100', 'dark:bg-rose-950/40', 'border-rose-500', 'text-rose-700', 'dark:text-rose-300');
                buttons[q.answer].classList.add('bg-emerald-100', 'dark:bg-emerald-950/40', 'border-emerald-500', 'text-emerald-700', 'dark:text-emerald-300');
                document.getElementById('quizFeedback').innerHTML = `<span class="text-rose-600 dark:text-rose-400"><i class="fa-solid fa-circle-xmark mr-1"></i> Incorrect. Correct option was highlighted.</span>`;
            }

            document.getElementById('nextQuestionBtn').classList.remove('hidden');
        }

        function showQuizResult() {
            document.getElementById('quizContainer').classList.add('hidden');
            document.getElementById('quizResult').classList.remove('hidden');
            document.getElementById('finalScore').innerText = `${quizScore} / ${quizQuestions.length}`;
        }

        function resetQuiz() {
            activeQuizIndex = 0;
            quizScore = 0;
            document.getElementById('quizResult').classList.add('hidden');
            document.getElementById('quizContainer').classList.remove('hidden');
            loadQuizQuestion();
        }

        // THEME MANAGER
        function setupTheme() {
            const themeToggleBtn = document.getElementById('themeToggle');
            const themeIcon = document.getElementById('themeIcon');
            
            const isDark = localStorage.getItem('g7_theme') === 'dark' || 
                (!('g7_theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);

            if (isDark) {
                document.documentElement.classList.add('dark');
                themeIcon.className = 'fa-solid fa-sun text-lg text-amber-400';
            } else {
                document.documentElement.classList.remove('dark');
                themeIcon.className = 'fa-solid fa-moon text-lg';
            }

            themeToggleBtn.addEventListener('click', () => {
                if (document.documentElement.classList.contains('dark')) {
                    document.documentElement.classList.remove('dark');
                    localStorage.setItem('g7_theme', 'light');
                    themeIcon.className = 'fa-solid fa-moon text-lg';
                } else {
                    document.documentElement.classList.add('dark');
                    localStorage.setItem('g7_theme', 'dark');
                    themeIcon.className = 'fa-solid fa-sun text-lg text-amber-400';
                }
            });
        }

        // DOWNLOAD MOCK HANDLER
        function downloadMock(filename) {
            showToast(`Downloading: ${filename}`);
        }

        // TOAST SYSTEM
        function showToast(message) {
            const toast = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>